{
    "name": "sillylounge",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "build": "node ./scripts/build.mjs",
        "check:build": "node ./scripts/runtime.mjs --check-only",
        "check:runtime": "node ./scripts/check-runtime.mjs",
        "dev": "node ./scripts/dev.mjs",
        "runtime": "pnpm run build && node ./scripts/runtime.mjs",
        "test": "pnpm run build && node --test",
        "typecheck": "tsc --noEmit",
        "verify": "pnpm run typecheck && pnpm run test && pnpm run check:build",
        "watch": "node ./scripts/dev.mjs"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.101.2",
        "preact": "^10.29.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "typescript": "^5.9.3",
        "vite": "^7.2.7"
    },
    "packageManager": "pnpm@11.9.0"
}
