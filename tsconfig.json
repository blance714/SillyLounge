{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "jsx": "react",
        "jsxFactory": "React.createElement",
        "jsxFragmentFactory": "React.Fragment",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "strict": true,
        "target": "ES2020",
        "types": []
    },
    "include": [
        "ui/**/*.ts",
        "ui/**/*.tsx"
    ]
}
