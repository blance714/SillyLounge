{
    "compilerOptions": {
        "allowJs": true,
        "baseUrl": ".",
        "checkJs": false,
        "jsx": "react",
        "jsxFactory": "React.createElement",
        "jsxFragmentFactory": "React.Fragment",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "paths": {
            "react": ["./node_modules/preact/compat/src/index.d.ts"],
            "react-dom": ["./node_modules/preact/compat/src/index.d.ts"],
            "react-dom/client": ["./node_modules/preact/compat/client.d.ts"],
            "react/jsx-runtime": ["./node_modules/preact/jsx-runtime/src/index.d.ts"],
            "react/jsx-dev-runtime": ["./node_modules/preact/jsx-runtime/src/index.d.ts"]
        },
        "strict": true,
        "target": "ES2020",
        "types": []
    },
    "include": [
        "ui/**/*.ts",
        "ui/**/*.tsx"
    ]
}
